package "Persistent entities (SQLite tables) — setup_db.py" {
  class Movie {
    +movieId : int <<PK>>
    +title : str
    +genres : str
  }
  class Rating {
    +userId : int <<PK>>
    +movieId : int <<PK>>
    +rating : float
    +timestamp : int
  }
  class Tag {
    +userId : int <<PK>>
    +movieId : int <<PK>>
    +tag : str <<PK>>
    +timestamp : int
  }
}
